#!/usr/bin/env bash
# Source this file from the repo root before running the backend in Codespaces:
#   source ./.env.codespaces.local
#
# This file is ignored by git via .env.*.local.

if [ -z "${CODESPACE_NAME:-}" ] || [ -z "${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN:-}" ]; then
  echo "This script must run inside GitHub Codespaces." >&2
  return 1 2>/dev/null || exit 1
fi

export APP_FRONTEND_BASE_URL="https://${CODESPACE_NAME}-5173.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}"
export APP_CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,${APP_FRONTEND_BASE_URL}"
export APP_OAUTH_FRONTEND_CALLBACK_URL="${APP_FRONTEND_BASE_URL}/oauth/callback"

export GOOGLE_OAUTH_REDIRECT_URI="https://${CODESPACE_NAME}-8080.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}/api/auth/oauth/google/callback"

export GMAIL_INTEGRATION_REDIRECT_URI="https://${CODESPACE_NAME}-8080.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}/api/settings/integrations/gmail/callback"
export GMAIL_INTEGRATION_FRONTEND_RETURN_URL="${APP_FRONTEND_BASE_URL}/settings"


echo "Codespaces OAuth/Gmail environment loaded."
echo "Frontend: ${APP_FRONTEND_BASE_URL}"
echo "Google OAuth callback: ${GOOGLE_OAUTH_REDIRECT_URI}"
echo "Gmail callback: ${GMAIL_INTEGRATION_REDIRECT_URI}"

if [ -z "${GOOGLE_OAUTH_CLIENT_ID}" ] || [ -z "${GOOGLE_OAUTH_CLIENT_SECRET}" ]; then
  echo "Warning: GOOGLE_OAUTH_CLIENT_ID and/or GOOGLE_OAUTH_CLIENT_SECRET are still empty." >&2
fi
