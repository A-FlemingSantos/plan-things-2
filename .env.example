# Local Windows defaults can stay implicit. Copy only what you need into
# .env.local or your shell environment. Do not commit real secrets.

SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=plan_things_db;encrypt=false;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=ChangeThis-12345
MSSQL_SA_PASSWORD=ChangeThis-12345

TEST_SQL_SERVER_HOST=localhost:1433
TEST_SQL_SERVER_USERNAME=sa
TEST_SQL_SERVER_PASSWORD=ChangeThis-12345

APP_FRONTEND_BASE_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=
APP_OAUTH_FRONTEND_CALLBACK_URL=http://localhost:5173/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback
GMAIL_INTEGRATION_REDIRECT_URI=http://localhost:8080/api/settings/integrations/gmail/callback
GMAIL_INTEGRATION_FRONTEND_RETURN_URL=http://localhost:5173/settings

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Mobile native Google Sign-In (same Web client ID as GOOGLE_OAUTH_CLIENT_ID).
# Requires a development build (EAS) — not available in Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only: reversed client ID from the iOS OAuth client
# (ex: com.googleusercontent.apps.123456789-abcdef)
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Optional: set after `eas init` if you prefer env over app.config extra.eas.projectId
# EAS_PROJECT_ID=
APP_INTEGRATION_TOKEN_KEY_B64=
APP_JWT_SECRET=dev-only-local-jwt-secret-change-me-00000000000000000000000000000000

INTELLIGENCE_ENABLED=false
OPENAI_API_KEY=
INTELLIGENCE_MODEL=gpt-5.4-mini
INTELLIGENCE_REASONING_EFFORT=low
INTELLIGENCE_MAX_OUTPUT_TOKENS=6000

VITE_DEV_HOST=localhost
VITE_API_PROXY_TARGET=http://localhost:8080
